{
  "components": {
    "schemas": {
      "BehaviorProbeCase": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Model",
            "type": "string"
          },
          "module": {
            "maxLength": 200,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
            "title": "Module",
            "type": "string"
          },
          "payload": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "id",
          "module",
          "model",
          "payload"
        ],
        "title": "BehaviorProbeCase",
        "type": "object"
      },
      "BehaviorProbeCaseComparison": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "enum": [
              "same_observation",
              "acceptance",
              "json_output",
              "error_type",
              "unavailable"
            ],
            "title": "Basis",
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "match",
              "different",
              "unsupported"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "basis"
        ],
        "title": "BehaviorProbeCaseComparison",
        "type": "object"
      },
      "BehaviorProbeComparison": {
        "additionalProperties": false,
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/BehaviorProbeCaseComparison"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Cases",
            "type": "array"
          },
          "review_only": {
            "const": true,
            "default": true,
            "title": "Review Only",
            "type": "boolean"
          },
          "suite_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Suite Digest",
            "type": "string"
          }
        },
        "required": [
          "suite_digest",
          "cases"
        ],
        "title": "BehaviorProbeComparison",
        "type": "object"
      },
      "BehaviorProbeObservation": {
        "additionalProperties": false,
        "properties": {
          "error_type": {
            "anyOf": [
              {
                "maxLength": 100,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Type"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "import_or_model_unavailable",
                  "not_pydantic_model",
                  "serialization_failed",
                  "output_limit",
                  "execution_interrupted"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "accepted",
              "rejected",
              "unsupported"
            ],
            "title": "Status",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "BehaviorProbeObservation",
        "type": "object"
      },
      "BehaviorProbeResults": {
        "additionalProperties": false,
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/BehaviorProbeObservation"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          },
          "suite_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Suite Digest",
            "type": "string"
          }
        },
        "required": [
          "suite_digest",
          "observations"
        ],
        "title": "BehaviorProbeResults",
        "type": "object"
      },
      "BehaviorProbeSuite": {
        "additionalProperties": false,
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/BehaviorProbeCase"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Cases",
            "type": "array"
          }
        },
        "required": [
          "cases"
        ],
        "title": "BehaviorProbeSuite",
        "type": "object"
      },
      "BranchResult": {
        "properties": {
          "behavior_probe_comparison": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BehaviorProbeComparison"
              },
              {
                "type": "null"
              }
            ]
          },
          "behavior_probe_error": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Behavior Probe Error"
          },
          "behavior_probe_results": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BehaviorProbeResults"
              },
              {
                "type": "null"
              }
            ]
          },
          "changed_files": {
            "minimum": 0.0,
            "title": "Changed Files",
            "type": "integer"
          },
          "changed_lines": {
            "minimum": 0.0,
            "title": "Changed Lines",
            "type": "integer"
          },
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Id"
          },
          "diagnostics": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnostics"
          },
          "elapsed_seconds": {
            "minimum": 0.0,
            "title": "Elapsed Seconds",
            "type": "number"
          },
          "failure_reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "lint_findings": {
            "minimum": 0.0,
            "title": "Lint Findings",
            "type": "integer"
          },
          "patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch"
          },
          "patch_applicable": {
            "default": true,
            "title": "Patch Applicable",
            "type": "boolean"
          },
          "pip_check_passed": {
            "title": "Pip Check Passed",
            "type": "boolean"
          },
          "pip_exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pip Exit Code"
          },
          "pydantic_major": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pydantic Major"
          },
          "status": {
            "$ref": "#/components/schemas/BranchStatus"
          },
          "strategy_id": {
            "enum": [
              "minimal",
              "compatibility",
              "refactor"
            ],
            "title": "Strategy Id",
            "type": "string"
          },
          "test_contract_preserved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Contract Preserved"
          },
          "test_exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Exit Code"
          },
          "test_outcomes_preserved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Outcomes Preserved"
          },
          "tests_collected": {
            "minimum": 0.0,
            "title": "Tests Collected",
            "type": "integer"
          },
          "tests_failed": {
            "minimum": 0.0,
            "title": "Tests Failed",
            "type": "integer"
          },
          "tests_passed": {
            "minimum": 0.0,
            "title": "Tests Passed",
            "type": "integer"
          },
          "tests_skipped": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tests Skipped"
          }
        },
        "required": [
          "strategy_id",
          "status",
          "tests_collected",
          "tests_passed",
          "tests_failed",
          "pip_check_passed",
          "lint_findings",
          "changed_files",
          "changed_lines",
          "elapsed_seconds"
        ],
        "title": "BranchResult",
        "type": "object"
      },
      "BranchStatus": {
        "enum": [
          "waiting",
          "running",
          "passed",
          "failed",
          "timed_out"
        ],
        "title": "BranchStatus",
        "type": "string"
      },
      "Citation": {
        "properties": {
          "evidence": {
            "title": "Evidence",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "evidence"
        ],
        "title": "Citation",
        "type": "object"
      },
      "CreateRunRequest": {
        "properties": {
          "baseline_ref": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Ref"
          },
          "behavior_probes": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BehaviorProbeSuite"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_path": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Path"
          },
          "repo_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Repo Url",
            "type": "string"
          },
          "target": {
            "const": "pydantic-v2",
            "default": "pydantic-v2",
            "title": "Target",
            "type": "string"
          },
          "test_extras": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$",
              "type": "string"
            },
            "maxItems": 8,
            "title": "Test Extras",
            "type": "array"
          }
        },
        "required": [
          "repo_url"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "MigrationStrategy": {
        "properties": {
          "id": {
            "enum": [
              "minimal",
              "compatibility",
              "refactor"
            ],
            "title": "Id",
            "type": "string"
          },
          "ordered_steps": {
            "items": {
              "type": "string"
            },
            "title": "Ordered Steps",
            "type": "array"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "source_urls": {
            "items": {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            "title": "Source Urls",
            "type": "array"
          },
          "target_files": {
            "items": {
              "type": "string"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Target Files",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "rationale",
          "ordered_steps",
          "source_urls",
          "target_files"
        ],
        "title": "MigrationStrategy",
        "type": "object"
      },
      "RunAdmissionError": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "RunAdmissionError",
        "type": "object"
      },
      "RunList": {
        "properties": {
          "limit": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunListItem"
            },
            "title": "Runs",
            "type": "array"
          }
        },
        "required": [
          "runs",
          "limit"
        ],
        "title": "RunList",
        "type": "object"
      },
      "RunListItem": {
        "description": "Small saved-run index; full evidence stays on the individual run.",
        "properties": {
          "baseline_tests_collected": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Tests Collected"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "mock",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "project_path": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Path"
          },
          "repo_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Repo Url",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "winner_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner Id"
          }
        },
        "required": [
          "id",
          "repo_url",
          "mode",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "RunListItem",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "preparing",
          "planning",
          "branching",
          "evaluating",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunSummary": {
        "properties": {
          "baseline_checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
