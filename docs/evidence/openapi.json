          "runtime_config_digest": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime Config Digest"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus",
            "default": "queued"
          },
          "strategies": {
            "items": {
              "$ref": "#/components/schemas/MigrationStrategy"
