          },
          "baseline_commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Commit Sha"
          },
          "baseline_probe_error": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Probe Error"
          },
          "baseline_probe_results": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BehaviorProbeResults"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_ref": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Ref"
          },
          "baseline_test_contract_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Test Contract Digest"
          },
          "baseline_tests_collected": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Tests Collected"
          },
          "baseline_tests_passed": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Tests Passed"
          },
          "baseline_tests_skipped": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Tests Skipped"
          },
          "behavior_probes": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BehaviorProbeSuite"
              },
              {
                "type": "null"
              }
            ]
          },
          "branches": {
            "items": {
              "$ref": "#/components/schemas/BranchResult"
            },
            "title": "Branches",
            "type": "array"
          },
          "citations": {
