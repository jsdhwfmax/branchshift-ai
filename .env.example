# Runtime mode: mock is fully offline; live calls Nebius, Tavily, and Contree.
BRANCHSHIFT_MODE=mock
DATABASE_URL=sqlite:///./branchshift.db
MOCK_STEP_DELAY_SECONDS=0.18
RUN_TIMEOUT_SECONDS=900
# Post-checkout tracked-file acceptance limit, before dependency installation.
MAX_REPOSITORY_BYTES=52428800
MAX_CONCURRENT_RUNS=2

# Public POST /api/runs admission (also enforced in mock mode).
# Starting defaults only; set actual deployment allowances from the approved budget.
# Accepted attempts, including failures/cancellations, consume persistent quota.
# Daily limits reset at 00:00 UTC; lifetime history is retained in DATABASE_URL.
# Zero daily/lifetime/client allowances close new admission; reads remain available.
HTTP_MAX_BODY_BYTES=8192
HTTP_DAILY_RUN_LIMIT=5
HTTP_LIFETIME_RUN_LIMIT=20
HTTP_MAX_PENDING_RUNS=2
HTTP_CLIENT_DAILY_RUN_LIMIT=2
HTTP_CLIENT_MAX_OUTSTANDING_RUNS=1
# Set in the process/host environment BEFORE launching Uvicorn. Empty means no
# trusted forwarded IPs; all clients behind a proxy may share its peer quota.
FORWARDED_ALLOW_IPS=

# Nebius Token Factory inference (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Configuration used by the retained successful live evaluation.
NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_ENABLE_THINKING=true

# Official-document retrieval
TAVILY_API_KEY=

# Token Factory Sandboxes / Contree
CONTREE_API_URL=https://api.tokenfactory.nebius.com/sandboxes
CONTREE_IMAGE=python:3.13-slim
