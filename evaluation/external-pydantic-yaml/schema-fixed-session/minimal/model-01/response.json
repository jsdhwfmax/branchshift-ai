] = False,","        default_style: YamlStyle = None,","        indent: Optional[bool] = None,","        encoding: Optional[str] = None,","        **kwargs,","    ) -> str:","        u0022u0022u0022Generate a YAML representation of the model.","","        Parameters","        ----------","        include, exclude","            Fields to include or exclude. See `dict()`.","        by_alias : bool","            Whether to use aliases instead of declared names. Default is False.","        skip_defaults, exclude_unset, exclude_defaults, exclude_none","            Arguments as per `BaseModel.dict()`.","        sort_keys : bool","            If True, will sort the keys in alphanumeric order for dictionaries.","            Default is False, which will dump in the field definition order.","        default_flow_style : bool or None","            Whether to use the 'flow' style in the dumper. By default, this is False,","            which uses the 'block' style (probably the most familiar to users).","        default_style : {None, '', u0027, u0022, '|', '>'}","            This is the default style for quoting strings, used by `ruamel.yaml` dumper.","            Default is None, which varies the style based on line length.","        indent, encoding, kwargs","            Additional arguments for the dumper.","        u0022u0022u0022","        data: 'DictStrAny' = self.model_dump(  # type: ignore","            include=include,","            exclude=exclude,","            by_alias=by_alias,","            skip_defaults=skip_defaults,","            exclude_unset=exclude_unset,","            exclude_defaults=exclude_defaults,","            exclude_none=exclude_none,","        )","","        if getattr(self, '__custom_root_type__', False):","            data = data.get('root', data)","            warnings.warn(","                'Explicit custom root behavior not yet implemented for pydantic_yaml. '","                'This may not work as expected. If so, please create a GitHub issue: '","                'https://github.com/NowanIlfideme/pydantic-yaml/issues/new'","            )","        cfg = self.model_config  # type: ignore","        return cfg['yaml_dumps'](","            data,","            sort_keys=sort_keys,","            default_flow_style=default_flow_style,","            default_style=default_style,","            encoding=encoding,","            indent=indent,","            **kwargs,","        )","","    @no_type_check","    @classmethod","    def parse_raw(","        cls: Type['Model'],","        b: Union[str, bytes],","        *,","        content_type: str = 'application/yaml',  # This is a reasonable default, right?","        encoding: str = 'utf-8',","        proto: ExtendedProto = None,","        allow_pickle: bool = False,","    ) -> 'Model':","        # NOTE: Type checking this function is a PITA, because we're overriding","        # BaseModel.parse_raw, but not inheriting it due to the MRO problem!","","        # Check whether we're specifically asked to parse YAML","        is_yaml = is_yaml_requested(content_type=content_type, proto=proto)","","        # Note that JSON is a subset of the YAML 1.2 spec, so we should be OK","        # even if JSON is passed. It will be slower, however.","        if is_yaml:","            try:","                cfg = cls.model_config  # type: ignore","                obj = cfg['yaml_loads'](b)","            except RecursionError as e:","                raise ValueError('YAML files with recursive references are unsupported.') from e","            except ValidationError:","                raise","            except Exception as e:","                raise ValidationError([{'exc': e, 'loc': 'root'}], cls) from e","        else:","            obj = load_str_bytes(","                b,","                proto=proto,","                content_type=content_type,","                encoding=encoding,","                allow_pickle=allow_pickle,","                json_loads=cls.model_config.get('json_loads'),","            )","        res = cls.model_validate(obj)  # type: ignore","        return cast('Model', res)","","    @no_type_check","    @classmethod","    def parse_file(","        cls: Type['Model'],","        path: Union[str, Path],","        *,","        content_type: str = None,","        encoding: str = 'utf-8',","        proto: ExtendedProto = None,","        allow_pickle: bool = False,","    ) -> 'Model':","        path = Path(path)","","        # Assume YAML based on the file name, so `parse_raw()` works well below","        if (content_type is None) and (path.suffix in ['.yml', '.yaml']):","            content_type = 'application/yaml'","","        # Check whether we're specifically asked to parse YAML","        is_yaml = is_yaml_requested(content_type=content_type, proto=proto, path_suffix=path.suffix)","","        # The first code path explicitly checks YAML compatibility.","        # We offload the rest to Pydantic.","        if is_yaml:","            b = path.read_bytes()","            return cls.parse_raw(","                b,","                content_type=content_type,","                encoding=encoding,","                proto=proto,","                allow_pickle=allow_pickle,","            )","        else:","            obj = load_file(","                path,","                proto=proto,","                content_type=content_type,","                encoding=encoding,","                allow_pickle=allow_pickle,","                json_loads=cls.model_config.get('json_loads'),","            )","            res = cls.model_validate(obj)  # type: ignore","            return cast('Model', res)","","    @classmethod","    def __try_update_forward_refs__(cls, **localns: Any) -> None:","        u0022u0022u0022","        Same as update_forward_refs but will not raise exception","        when forward references are not defined.","        u0022u0022u0022","        try:","            if issubclass(cls, BaseModel):","                super().__try_update_forward_refs__(**localns)  # type: ignore","        except AttributeError:","            pass"],"path":"src/pydantic_yaml/mixin.py"},{"lines":["from pydantic import BaseModel","","from .mixin import YamlModelMixin","","_pre_doc = u0022u0022u0022`pydantic.BaseModel` class with built-in YAML support.","","You can alternatively inherit from this to implement your model:","`(pydantic_yaml.YamlModelMixin, pydantic.BaseModel)`","","See Also","--------","pydantic-yaml: https://github.com/NowanIlfideme/pydantic-yaml","pydantic: https://docs.pydantic.dev/","pyyaml: https://pyyaml.org/","ruamel.yaml: https://yaml.readthedocs.io/en/latest/index.html","u0022u0022u0022","","","class YamlModel(YamlModelMixin, BaseModel):","    __doc__ = _pre_doc + BaseModel.__doc__"],"path":"src/pydantic_yaml/model.py"},{"lines":["u0022u0022u0022Module for some hacks that are needed to work around the YAML library interfaces.","","Mainy, this defines 'safe' representers for common types that Pydantic is able to parse.u0022u0022u0022","","__all__ = ['inject_all']","","from typing import List, Type","","from .representers import register_str_like, register_int_like","","","def get_str_like_types() -> List[Type]:","    u0022u0022u0022Returns many string-like types from stdlib and Pydantic.u0022u0022u0022","","    # flake8: noqa","","    from uuid import UUID","    from pathlib import (","        Path,","        PosixPath,","        PurePath,","        PurePosixPath,","        PureWindowsPath,","        WindowsPath,","    )","","    from pydantic.types import (","        SecretStr,","        SecretBytes,","    )","","    def _chk(x) -> bool:","        try:","            return issubclass(x, (str, Path, PurePath, UUID))","        except Exception:","            return False","","    # Get most candidates","    candidates = [","        str,","        Path,","        PosixPath,","        PurePath,","        PurePosixPath,","        PureWindowsPath,","        WindowsPath,","        UUID,","        SecretStr,","        SecretBytes,","    ]","    str_like = [v for v in candidates if _chk(v)]","","    # SecretStr, SecretBytes are stringified as '**********' by Pydantic","    str_like += [SecretStr, SecretBytes]","    return str_like","","","def get_int_like_types() -> List[Type]:","    u0022u0022u0022Returns many int-like types from stdlib and Pydantic.u0022u0022u0022","","    from pydantic.types import (","        ByteSize,","        PaymentCardNumber,","    )","","    def _chk(x) -> bool:","        try:","            return issubclass(x, (int,))","        except Exception:","            return False","","    candidates = [","        int,","        ByteSize,","        PaymentCardNumber,","    ]","    int_like = [v for v in candidates if _chk(v)]","    return int_like","","","def inject_all():","    u0022u0022u0022Injects all necessary 'hacks' into the namespace.","","    What this currently does:","    - Registers many str-like and int-like types (from Pydantic and the standard","      library) to be representable in YAML.","    u0022u0022u0022","    # Add representers for string-like and int-like values.","    for cls in get_str_like_types():","        register_str_like(cls, method=str)","    for cls in get_int_like_types():","        register_int_like(cls, method=int)"],"path":"src/pydantic_yaml/compat/hacks.py"},{"lines":["from functools import wraps","from typing import Any, Callable, Optional, Union, no_type_check","","from pydantic import ValidationError","from pydantic_yaml.compat.types import YamlStr","from semver import VersionInfo","","__all__ = ['SemVer']","","","Comparator = Callable[['SemVer', Any], bool]","","","def _comparator(operator: Comparator) -> Comparator:","    u0022u0022u0022Wrap a Version binary op method in a type-check.u0022u0022u0022","","    @wraps(operator)","    def wrapper(self: 'SemVer', other: Any) -> bool:","        if not isinstance(other, SemVer):","            try:","                other = SemVer(other)","            except Exception:","                return NotImplemented","        return operator(self, other)","","    return wrapper","","","class SemVer(YamlStr):  # want to inherit from VersionInfo, but metaclass conflict","    u0022u0022u0022Semantic Version string for Pydantic.","","    Depends on `semver` versions 2 or 3. Look here for how to fix the version:","    https://python-semver.readthedocs.io/en/3.0.0-dev.2/install.html#release-policy","    u0022u0022u0022","","    allow_build: bool = True","    allow_prerelease: bool = True","","    __slots__ = ['_info']","","    @no_type_check","    def __new__(cls, version: Optional[str], **kwargs) -> object:","        return YamlStr.__new__(cls, cls.parse(**kwargs) if version is None else version)","","    def __init__(self, version: str):","        str.__init__(version)","        self._info = VersionInfo.parse(version)","","    @classmethod","    def parse(","        self,","        major: int,","        minor: int = 0,","        patch: int = 0,","        prerelease: Optional[str] = None,","        build: Optional[str] = None,","    ) -> str:","        return str(VersionInfo(major, minor, patch, prerelease, build))","","    @classmethod","    def __get_validators__(cls):","        yield cls.validate","","    @classmethod","    def validate(cls, value: Union[str, 'SemVer']) -> 'SemVer':","        vi = VersionInfo.parse(value)","        if not cls.allow_build and (vi.build is None):","            raise ValidationError('build is required')","        if not cls.allow_prerelease and (vi.prerelease is None):","            raise ValidationError('prerelease is required')","        return cls(value)","","    @property","    def info(self) -> VersionInfo:","        return self._info","","    @info.setter","    def info(self, value):","        raise AttributeError('attribute 'info' is readonly')","","    @property","    def major(self) -> int:","        u0022u0022u0022The major part of a version (read-only).u0022u0022u0022","        return self._info.major","","    @major.setter","    def major(self, value):","        raise AttributeError('attribute 'major' is readonly')","","    @property","    def minor(self) -> int:","        u0022u0022u0022The minor part of a version (read-only).u0022u0022u0022","        return self._info.minor","","    @minor.setter","    def minor(self, value):","        raise AttributeError('attribute 'minor' is readonly')","","    @property","    def patch(self) -> int:","        u0022u0022u0022The patch part of a version (read-only).u0022u0022u0022","        return self._info.patch","","    @patch.setter","    def patch(self, value):","        raise AttributeError('attribute 'patch' is readonly')","","    @property","    def prerelease(self) -> Optional[str]:","        u0022u0022u0022The prerelease part of a version (read-only).u0022u0022u0022","        return self._info.prerelease","","    @prerelease.setter","    def prerelease(self, value):","        raise AttributeError('attribute 'prerelease' is readonly')","","    @property","    def build(self) -> Optional[str]:","        u0022u0022u0022The build part of a version (read-only).u0022u0022u0022","        return self._info.build","","    @build.setter","    def build(self, value):","        raise AttributeError('attribute 'build' is readonly')","","    def __hash__(self) -> int:","        return super().__hash__()  # use string hashing","","    @_comparator","    def __eq__(self, other: 'SemVer'):","        return self._info == other._info","","    @_comparator","    def __ne__(self, other: 'SemVer'):","        return self._info != other._info","","    @_comparator","    def __lt__(self, other: 'SemVer'):","        return self._info < other._info","","    @_comparator","    def __le__(self, other: 'SemVer'):","        return self._info <= other._info","","    @_comparator","    def __gt__(self, other: 'SemVer'):","        return self._info > other._info","","    @_comparator","    def __ge__(self, other: 'SemVer'):","        return self._info >= other._info"],"path":"src/pydantic_yaml/ext/semver.py"},{"lines":["from typing import Optional, Tuple, Type","import warnings","","from pydantic import field_validator","","from pydantic_yaml.model import YamlModel","from .semver import SemVer","","__all__ = ['VersionedYamlModel']","","","def _chk_between(v, lo=None, hi=None):","    if v is None:","        return","    if (hi is not None) and (v > hi):","        raise ValueError(f'Default version higher than maximum: {v} > {hi}')","    if (lo is not None) and (v < lo):","        raise ValueError(f'Default version lower than minimum: {v} < {lo}')","","","def _get_minmax_robust(","    cls: Type['VersionedYamlModel'],",") -> Tuple[Optional[SemVer], Optional[SemVer]]:","    min_, max_ = None, None","    for supcls in cls.mro():","        Config = getattr(supcls, 'Config', None)","        if Config is not None:","            if min_ is None:","                min_ = getattr(Config, 'min_version', None)","            if max_ is None:","                max_ = getattr(Config, 'max_version', None)","    return min_, max_","","","class VersionedYamlModel(YamlModel):","    u0022u0022u0022YAML model with versioning support.","","    Usage","    -----","    Inherit from this class, and set a Config class with attributes","    `min_version` and/or `max_version`:","","    ```python","    class MyModel(VersionedYamlModel):","        class Config:","            min_version = '1.0.0'","","        foo: str = 'bar'","    ```","","    By default, the minimum version is '0.0.0' and the maximum is unset.","    This pattern enables you to more easily version your YAML files and","    protect against accidentally using older (or newer) configuration file formats.","","    Notes","    -----","    By default, a validator checks that the 'version' field is between","    `Config.min_version` and `Config.max_version`, if those are not None.","","    It's probably best not to even set the `version` field by hand, but rather","    in your configuration.","    u0022u0022u0022","","    version: SemVer","","    def __init_subclass__(cls) -> None:","        # Check Config class types","        Config = getattr(cls, 'Config', None)","        if Config is not None:","            # check one field","            minv = getattr(Config, 'min_version', None)","            if minv is not None:","                if not isinstance(minv, SemVer):","                    setattr(Config, 'min_version', SemVer(minv))","            # check other field","            maxv = getattr(Config, 'max_version', None)","            if maxv is not None:","                if not isinstance(maxv, SemVer):","                    setattr(Config, 'max_version', SemVer(maxv))","","        # Check ranges","        min_, max_ = _get_minmax_robust(cls)","        if (min_ is not None) and (max_ is not None) and (min_ > max_):","            raise ValueError(f'Minimum version higher than maximum: {min_!r} > {max_!r}')","","        # Check the default value of the 'version' field","        # In v2, we use model_fields instead of __fields__","        fields = getattr(cls, 'model_fields', {})","        fld = fields.get('version')","        if fld is not None:","            d = fld.default","            if d is not None:","                _chk_between(d, lo=min_, hi=max_)","                warnings.warn(","                    f'Recommended to have `version` be required, but set default {d!r}',","                    UserWarning,","                )","","            if not issubclass(fld.annotation, SemVer):","                raise TypeError(f'Field type for `version` must be SemVer, got {fld.annotation!r}')","","    @field_validator('version', mode='before')","    def _check_semver(cls, v):","        min_, max_ = _get_minmax_robust(cls)","        _chk_between(v, lo=min_, hi=max_)","        return v","","    class Config:","        min_version = SemVer('0.0.0')","        max_version = None"],"path":"src/pydantic_yaml/ext/versioned_model.py"},{"lines":["u0022u0022u0022Defines useful types for building your own YAML-compatible types.u0022u0022u0022","","from enum import Enum","from inspect import isabstract","from typing import Dict, Tuple, Union","","from .representers import register_int_like, register_str_like","from .yaml_lib import yaml_safe_dump","","__all__ = ['YamlInt', 'YamlIntEnum', 'YamlStr', 'YamlStrEnum']","","","class YamlStr(str):","    u0022u0022u0022A `str` subclass that serializes to YAML as an integer.u0022u0022u0022","","    def __init_subclass__(cls):","        u0022u0022u0022Adds a representer when defining a subclass.u0022u0022u0022","        res = super().__init_subclass__()","        if not isabstract(cls):","            register_str_like(cls, method=cls._to_yaml_str)","        return res","","    @classmethod","    def _to_yaml_str(cls, v) -> str:","        u0022u0022u0022Represent a value of this type as a string.u0022u0022u0022","        return str(v)","","    def __str__(self) -> str:","        u0022u0022u0022This just returns the wrapped string.u0022u0022u0022","        return super().__str__()","","    def __repr__(self) -> str:","        u0022u0022u0022Repr string that keeps the class type. You may redefine this.u0022u0022u0022","        return type(self).__qualname__ + '(' + super().__repr__() + ')'","","    def __getnewargs__(self) -> Tuple[str]:","        u0022u0022u0022Implementation to prevent Enum from sabotaging us.","","        I'm not joking! See `_make_class_unpicklable()` from `enum.py`","        u0022u0022u0022","        return super().__getnewargs__()","","","class YamlInt(int):","    u0022u0022u0022An `int` subclass that serializes to YAML as an integer.u0022u0022u0022","","    def __init_subclass__(cls):","        u0022u0022u0022Adds a representer when defining a subclass.u0022u0022u0022","        res = super().__init_subclass__()","        if not isabstract(cls):","            register_int_like(cls, method=cls._to_yaml_int)","        return res"