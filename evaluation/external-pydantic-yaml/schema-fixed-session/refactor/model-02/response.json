           )","        return cls.model_parse_raw(data,  # type: ignore","            content_type='application/json',","            **kwargs,","        )","","    @classmethod","    def parse_file(","        cls,","        path: Union[str, Path],","        *,","        content_type: Optional[str] = None,","        proto: Optional[str] = None,","        **kwargs,","    ) -> 'Model':","        u0022u0022u0022Parse a YAML/JSON file into a model instance.","","        This delegates to `model_parse_file` from Pydantic v2.","        u0022u0022u0022","        path = Path(path)","        is_yaml = is_yaml_requested(content_type=content_type, proto=proto, path_suffix=path.suffix)","        if is_yaml:","            return cls.model_parse_file(path,  # type: ignore","                content_type='application/yaml',","                **kwargs,","            )","        return cls.model_parse_file(path,  # type: ignore","            content_type='application/json',","            **kwargs,","        )","","    @classmethod","    def parse_obj(","        cls,","        obj: Any,","        *,","        **kwargs,","    ) -> 'Model':","        u0022u0022u0022Parse a Python object (dict, list, etc.) into a model instance.","","        This delegates to `model_parse_obj` from Pydantic v2.","        u0022u0022u0022","        return cls.model_parse_obj(obj, **kwargs)  # type: ignore","","    @classmethod","    def model_parse_raw(","        cls,","        data: Union[str, bytes],","        *,","        content_type: str,","        **kwargs,","    ) -> 'Model':","        u0022u0022u0022Parse raw string/bytes data using the configured loader.","        u0022u0022u0022","        if content_type == 'application/yaml':","            loader = cls.model_config['yaml_loads']","            obj = loader(data)","        else:","            import json","            obj = json.loads(data)","        return cls.model_parse_obj(obj, **kwargs)","","    @classmethod","    def model_parse_file(","        cls,","        path: Path,","        *,","        content_type: str,","        **kwargs,","    ) -> 'Model':","        u0022u0022u0022Parse a file using the configured loader.","        u0022u0022u0022","        if content_type == 'application/yaml':","            loader = cls.model_config['yaml_loads']","            with path.open('r', encoding='utf-8') as f:","                obj = loader(f.read())","        else:","            import json","            with path.open('r', encoding='utf-8') as f:","                obj = json.load(f)","        return cls.model_parse_obj(obj, **kwargs)","","    @classmethod","    def model_parse_obj(","        cls,","        obj: Any,","        **kwargs,","    ) -> 'Model':","        u0022u0022u0022Parse a Python object into a model instance.","        u0022u0022u0022","        return cls.model_validate(obj, **kwargs)  # type: ignore","","    def model_dump(","        self,","        *,","        include: Union['AbstractSetIntStr', 'MappingIntStrAny', None] = None,","        exclude: Union['AbstractSetIntStr', 'MappingIntStrAny', None] = None,","        by_alias: bool = False,","        skip_defaults: Optional[bool] = None,","        exclude_unset: bool = False,","        exclude_defaults: bool = False,","        exclude_none: bool = False,","        **kwargs,","    ) -> 'DictStrAny':","        u0022u0022u0022Dump model to a dict using v2's model_dump.","        u0022u0022u0022","        return self.model_dump(  # type: ignore","            include=include,","            exclude=exclude,","            by_alias=by_alias,","            skip_defaults=skip_defaults,","            exclude_unset=exclude_unset,","            exclude_defaults=exclude_defaults,","            exclude_none=exclude_none,","            **kwargs,","        )","","    def model_dump_json(","        self,","        *,","        include: Union['AbstractSetIntStr', 'MappingIntStrAny', None] = None,","        exclude: Union['AbstractSetIntStr', 'MappingIntStrAny', None] = None,","        by_alias: bool = False,","        skip_defaults: Optional[bool] = None,","        exclude_unset: bool = False,","        exclude_defaults: bool = False,","        exclude_none: bool = False,","        sort_keys: bool = False,","        **kwargs,","    ) -> str:","        u0022u0022u0022Dump model to JSON string using v2's model_dump_json.","        u0022u0022u0022","        import json","        data = self.model_dump(  # type: ignore","            include=include,","            exclude=exclude,","            by_alias=by_alias,","            skip_defaults=skip_defaults,","            exclude_unset=exclude_unset,","            exclude_defaults=exclude_defaults,","            exclude_none=exclude_none,","            **kwargs,","        )","        return json.dumps(data, sort_keys=sort_keys, **kwargs)",""],"path":"src/pydantic_yaml/mixin.py"},{"lines":["from pydantic import BaseModel","","from .mixin import YamlModelMixin","","_pre_doc = u0022u0022u0022`pydantic.BaseModel` class with built-in YAML support.","","You can alternatively inherit from this to implement your model:","`(pydantic_yaml.YamlModelMixin, pydantic.BaseModel)`","","See Also","--------","pydantic-yaml: https://github.com/NowanIlfideme/pydantic-yaml","pydantic: https://pydantic-docs.helpmanual.io/","pyyaml: https://pyyaml.org/","ruamel.yaml: https://yaml.readthedocs.io/en/latest/index.html","u0022u0022u0022","","","class YamlModel(YamlModelMixin, BaseModel):","    model_config = {'populate_by_name': True, 'str_strip_whitespace': True, 'from_attributes': True}","    __doc__ = _pre_doc + (BaseModel.__doc__ or '')"],"path":"src/pydantic_yaml/model.py"},{"lines":["u0022u0022u0022Module for some hacks that are needed to work around the YAML library interfaces.","","Mainly, this defines 'safe' representers for common types that Pydantic is able to parse.","u0022u0022u0022","","__all__ = ['inject_all']","","from typing import List, Type","","from .representers import register_str_like, register_int_like","","","def get_str_like_types() -> List[Type]:","    u0022u0022u0022Returns many string-like types from stdlib and Pydantic.u0022u0022u0022","","    # flake8: noqa","","    from uuid import UUID","    from pathlib import (","        Path,","        PosixPath,","        PurePath,","        PurePosixPath,","        PureWindowsPath,","        WindowsPath,","    )","","    from pydantic import types","","    def _chk(x) -> bool:","        try:","            return issubclass(x, (str, Path, UUID))","        except Exception:","            return False","","    # Get most candidates","    candidates = (","        list(locals().values())","        + [getattr(types, v) for v in types.__all__]","    )","    str_like = [v for v in candidates if _chk(v)]","","    # SecretStr, SecretBytes are stringified as '**********' by Pydantic","    str_like += [types.SecretStr, types.SecretBytes]","    return str_like","","","def get_int_like_types() -> List[Type]:","    u0022u0022u0022Returns many int-like types from stdlib and Pydantic.u0022u0022u0022","","    from pydantic import types","","    def _chk(x) -> bool:","        try:","            return issubclass(x, (int,))","        except Exception:","            return False","","    candidates = list(locals().values()) + [getattr(types, v) for v in types.__all__]","    int_like = [v for v in candidates if _chk(v)]","    return int_like","","","def inject_all():","    u0022u0022u0022Injects all necessary 'hacks' into the namespace.","","    What this currently does:","    - Registers many str-like and int-like types (from Pydantic and the standard","      library) to be representable in YAML.","    u0022u0022u0022","    # Add representers for string-like and int-like values.","    for cls in get_str_like_types():","        register_str_like(cls, method=str)","    for cls in get_int_like_types():","        register_int_like(cls, method=int)"],"path":"src/pydantic_yaml/compat/hacks.py"},{"lines":["from __future__ import annotations","","from functools import wraps","from typing import Any, Callable, Optional, Union","","from pydantic import ValidationError","from pydantic.types import StringConstraints","from semver import VersionInfo","","__all__ = ['SemVer']","","","class SemVer(StringConstraints):","    u0022u0022u0022Semantic Version string for Pydantic.","","    Depends on `semver` versions 2 or 3. Look here for how to fix the version:","    https://python-semver.readthedocs.io/en/3.0.0-dev.2/install.html#release-policy","    u0022u0022u0022","","    allow_build: bool = True","    allow_prerelease: bool = True","","    __slots__ = ['_info']","","    def __init__(self, value: str):","        self._value = value","        self._info = VersionInfo.parse(value)","","    @classmethod","    def __get_pydantic_json_schema__(cls, core_schema, handler):","        return handler(StringConstraints(min_length=1))","","    @classmethod","    def __get_pydantic_serialization__(cls):","        return str","","    @classmethod","    def parse(","        cls,","        major: int,","        minor: int = 0,","        patch: int = 0,","        prerelease: Optional[str] = None,","        build: Optional[str] = None,","    ) -> str:","        return str(VersionInfo(major, minor, patch, prerelease, build))","","    @classmethod","    def __get_pydantic_validators__(cls):","        yield cls.validate","","    @classmethod","    def validate(cls, value: Union[str, 'SemVer']) -> 'SemVer':","        if isinstance(value, cls):","            return value","        vi = VersionInfo.parse(value)","        if not cls.allow_build and (vi.build is None):","            raise ValidationError('build is required')","        if not cls.allow_prerelease and (vi.prerelease is None):","            raise ValidationError('prerelease is required')","        return cls(value)","","    @property","    def info(self) -> VersionInfo:","        return self._info","","    @property","    def major(self) -> int:","        u0022u0022u0022The major part of a version (read-only).u0022u0022u0022","        return self._info.major","","    @property","    def minor(self) -> int:","        return self._info.minor","","    @property","    def patch(self) -> int:","        return self._info.patch","","    @property","    def prerelease(self) -> Optional[str]:","        return self._info.prerelease","","    @property","    def build(self) -> Optional[str]:","        return self._info.build","","    def __str__(self) -> str:","        return self._value","","    def __repr__(self) -> str:","        return f'SemVer({self._value!r})'","","    def __eq__(self, other: object) -> bool:","        if isinstance(other, SemVer):","            return self._value == other._value","        if isinstance(other, str):","            return self._value == other","        return NotImplemented","","    def __hash__(self) -> int:","        return hash(self._value)"],"path":"src/pydantic_yaml/ext/semver.py"},{"lines":["from __future__ import annotations","","import warnings","from typing import Any, ClassVar, Optional, Type","","from pydantic import BaseModel, field_validator","from pydantic.types import StringConstraints","","from .semver import SemVer","from ..model import YamlModel","","__all__ = ['VersionedYamlModel']","","","class VersionedYamlModelConfig:","    u0022u0022u0022Configuration for VersionedYamlModel.u0022u0022u0022","","    version_field: str = 'version'","    min_version: Optional[str] = None","    max_version: Optional[str] = None","","","class VersionedYamlModel(YamlModel):","    u0022u0022u0022A YamlModel that validates a version field.","","    By default, a validator checks that the 'version' field is between","    min_version and max_version (inclusive) if they are set.","","    You can customize the version field name and constraints by setting","    `model_config` in your subclass.","    u0022u0022u0022","","    model_config = {'populate_by_name': True, 'str_strip_whitespace': True, 'from_attributes': True}","","    version: SemVer","","    @field_validator('version', mode='before')","    @classmethod","    def _check_version(cls, v: str) -> str:","        cfg = cls.model_config","        min_v = cfg.get('min_version')","        max_v = cfg.get('max_version')","        if min_v is not None:","            min_semver = SemVer.parse(min_v) if isinstance(min_v, str) else min_v","            if SemVer(v) < min_semver:","                raise ValueError(f'Version {v} is less than minimum {min_v}')","        if max_v is not None:","            max_semver = SemVer.parse(max_v) if isinstance(max_v, str) else max_v","            if SemVer(v) > max_semver:","                raise ValueError(f'Version {v} is greater than maximum {max_v}')","        return v","","    def __init_subclass__(cls) -> None:","        super().__init_subclass__()","        cfg = cls.model_config","        if not isinstance(cfg, dict):","            cfg = dict(cfg)","        if 'version_field' not in cfg:","            cfg['version_field'] = 'version'","        cls.model_config = cfg"],"path":"src/pydantic_yaml/ext/versioned_model.py"},{"lines":["from __future__ import annotations","","from enum import Enum","from inspect import isabstract","from typing import Any, Dict, Tuple, Type","","from pydantic import BaseModel","from pydantic.types import StringConstraints","","from .representers import register_int_like, register_str_like","from .yaml_lib import yaml_safe_dump","","__all__ = ['YamlInt', 'YamlIntEnum', 'YamlStr', 'YamlStrEnum']","","","class YamlStr(StringConstraints):","    u0022u0022u0022A `str` subclass that serializes to YAML as a string.","","    This uses Pydantic v2's StringConstraints for validation and serialization hooks.","    u0022u0022u0022","","    min_length: int = 0","","    @classmethod","    def __get_pydantic_json_schema__(cls, core_schema, handler):","        return handler(StringConstraints(min_length=cls.min_length))","","    @classmethod","    def __get_pydantic_serialization__(cls):","        return str","","    def __init_subclass__(cls):","        super().__init_subclass__()","        if not isabstract(cls):","            register_str_like(cls, method=str)","","    def __str__(self) -> str:","        return str(self._value) if hasattr(self, '_value') else str(self)","","    def __repr__(self) -> str:","        return f'{self.__class__.__qualname__}({str(self)!r})'","","","class YamlInt(StringConstraints):","    u0022u0022u0022An `int` subclass that serializes to YAML as an integer.","","    This uses Pydantic v2's StringConstraints for validation and serialization hooks.","    u0022u0022u0022","","    @classmethod","    def __get_pydantic_json_schema__(cls, core_schema, handler):","        return handler(StringConstraints(pattern=r'^-?[0-9]+$'))","","    @classmethod","    def __get_pydantic_serialization__(cls):","        return int","","    def __init_subclass__(cls):","        super().__init_subclass__()","        if not isabstract(cls):","            register_int_like(cls, method=int)","","    def __int__(self) -> int:","        return int(self._value) if hasattr(self, '_value') else int(self)","","    def __str__(self) -> str:","        return str(self._value) if hasattr(self, '_value') else str(self)","","    def __repr__(self) -> str:","        return f'{self.__class__.__qualname__}({int(self)!r})'","","","class YamlStrEnum(YamlStr, Enum):","    u0022u0022u0022String-valued enum that serializes to YAML directly as a string.","","    This also checks that your enum can properly be serialized.","    u0022u0022u0022","","    def __init_subclass__(cls):","        super().__init_subclass__()","        if not isabstract(cls):","            vals: Dict[str, Any] = {k: v for k, v in cls.__members__.items()}","            yaml_safe_dump(vals)","","    def __str__(self) -> str:","        return str(self.value)","","    def __repr__(self) -> str:","        return f'{self.__class__.__qualname__}.{self.name}'","","","class YamlIntEnum(YamlInt, Enum):","    u0022u0022u0022Integer-valued enum that serializes to YAML directly as an integer.","","    This also checks that your enum can properly be serialized.","    u0022u0022u0022","","    def __init_subclass__(cls):","        super().__init_subclass__()","        if not isabstract(cls):","            vals: Dict[str, Any] = {k: v for k, v in cls.__members__.items()}","            yaml_safe_dump(vals)","","    def __int__(self) -> int:","        return int(self.value)","","    def __str__(self) -> str:","        return str(self.value)","","    def __repr__(self) -> str:","        return f'{self.__class__.__qualname__}.{self.name}'"],"path":"src/pydantic_yaml/compat/types.py"},{"lines":["u0022u0022u0022Imports an installed YAML library. Prefers ruamel.yaml new API.u0022u0022u0022","","# flake8: noqa","","from typing import Any, Optional","from io import BytesIO, StringIO, IOBase","","","try:","    import ruamel.yaml as yaml  # type: ignore","","    # ruamel.yaml doesn't have type annotations","","    __yaml_lib__ = 'ruamel-new'","except ImportError:","    try:","        import yaml  # type: ignore","","        __yaml_lib__ = 'pyyaml'","    except ImportError:","        raise ImportError(","            'Could not import ruamel.yaml or pyyaml, please install at least one of them.',",")","","dumper_classes = []","for _fld in dir(yaml):","    try:","        if 'Dumper' in _fld:","            _obj = getattr(yaml, _fld)","            dumper_classes.append(_obj)","    except Exception:","        pass","","representer_classes = []","for _fld in dir(yaml):","    try:","        if 'Representer' in _fld:","            _obj = getattr(yaml, _fld)","            representer_classes.append(_obj)","    except Exception:","        pass","","","def yaml_safe_load(stream) -> Any:","    u0022u0022u0022Wrapper around YAML library loader.u0022u0022u0022","    if __yaml_lib__ == 'pyyaml':","        return yaml.safe_load(stream)","    # ruamel-new API","    ruamel_obj = yaml.YAML(typ='safe', pure=True)","    if isinstance(stream, str):","        return ruamel_obj.load(StringIO(stream))","    elif isinstance(stream, bytes):","        return ruamel_obj.load(BytesIO(stream))","    # we hope it's a stream, but don't enforce it","    return ruamel_obj.load(stream)","","","def yaml_safe_dump(data: Any, stream=None, *, sort_keys: bool = False, **kwds) -> Optional[Any]:","    u0022u0022u0022Wrapper around YAML library dumper.","","    Parameters","    ----------","    data","        The data you want to dump, typically a mapping (dict).","    stream","        The stream to dump to. By default (if no stream is given, i.e. None),","        this will instead dump to a text stream.","    sort_keys : bool","        Whether to sort the keys of mappings before dumping.","        Default value is False, rather than True, which is the YAML default.","        This is because Pydantic configs are easier to read if dumped in the","        same order as they are defined.","    kwds","        Other keyword arguments to set on the YAML dumper instance.","    u0022u0022u0022","    if __yaml_lib__ == 'pyyaml':","        return yaml.safe_dump(data, stream=stream, sort_keys=sort_keys, **kwds)","    # ruamel-new API","    ruamel_obj = yaml.YAML(typ='safe', pure=True)","    ruamel_obj.sort_base_mapping_type_on_output = sort_keys  # type: ignore","    # Hacking some options that aren't available","    for kw in ['encoding', 'default_flow_style', 'default_style', 'indent']:","        if kw in kwds:","            setattr(ruamel_obj, kw, kwds[kw])","","    if stream is None:","        text_stream = StringIO()","        ruamel_obj.dump(data, stream=text_stream)","        text_stream.seek(0)  # otherwise we always get ''","        return text_stream.read()","    else:","        ruamel_obj.dump(data, stream=stream)","        return None","","","__all__ = ['yaml_safe_dump', 'yaml_safe_load', 'yaml', '__yaml_lib__']"],"path":"src/pydantic_yaml/compat/yaml_lib.py"},{"lines":[""],"path":"src/pydantic_yaml/compat/old_enums.py"},{"lines":["u0022u0022u0022Representers for dumping common objects to YAML.u0022u0022u0022","","from functools import partial","from typing import Any, Callable, TypeVar","","from .yaml_lib import yaml, dumper_classes, representer_classes","","CType = TypeVar('CType')","","__all__ = ['register_str_like', 'register_int_like']","","","def dump_as_str(dumper: Any, data: Any, method: Callable[[Any], str] = str):","    u0022u0022u0022Represents an object as a string in YAML.","","    Parameters","    ----------","    dumper : Any","        The dumper instance, such as `yaml.YAML(...)`.","    data","        The object to dump. Ideally this is string-like.","    method : callable","        A method that converts `data` to a string. Default is `str`.","","    Returns","    -------","    node","        The YAML internal node representation.","    u0022u0022u0022","    return dumper.represent_str(method(data))","","","def dump_as_int(dumper: Any, data: Any, method: Callable[[Any], int] = int):","    u0022u0022u0022Represents an object as an integer in YAML.","","    Parameters","    ----------","    dumper : Any","        The dumper instance, such as `yaml.YAML(...)`.","    data","        The object to dump. Ideally this is int-like.","    method : callable","        A method that converts `data` to an integer. Default is `int`.","","    Returns","    -------","    node","        The YAML internal node representation.","    u0022u0022u0022","    return dumper.represent_int(method(data))","","","def register_str_like(cls: CType, method: Callable[[Any], str] = str) -> CType:","    u0022u0022u0022Registers `cls` to be dumped to YAML as a string.","","    Parameters","    ----------","    cls : Type","        The class to represent.","    method : callable","        A method that converts objects of type `cls` to a string.","        Default is `str`.","","    Returns","    -------","    cls","        This is the same as the input `cls`.","    u0022u0022u0022","    for x_cls in dumper_classes + representer_classes:","        x_cls.add_representer(cls, partial(dump_as_str, method=method))","    return cls","","","def register_int_like(cls: CType, method: Callable[[Any], int] = int) -> CType:","    u0022u0022u0022Registers `cls` to be dumped to YAML as an integer.","","    Parameters","    ----------","    cls : Type","        The class to represent.","    method : callable","        A method that converts objects of type `cls` to an integer.","        Default is `int`.","","    Returns","    -------","    cls","        This is the same as the input `cls`.","    u0022u0022u0022","    for x_cls in dumper_classes + representer_classes:","        x_cls.add_representer(cls, partial(dump_as_int, method=method))","    return cls"],"path":"src/pydantic_yaml/compat/representers.py"},{"lines":["u0022u0022u0022YAML-enabled Pydantic models.u0022u0022u0022","","__all__ = [","    '__version__',","    'yaml',","    'yaml_safe_dump',","    'yaml_safe_load',","    'YamlInt',","    'YamlIntEnum',","    'YamlModel',","    'YamlModelMixin',","    'YamlModelMixinConfig',","    'YamlStr',","    'YamlStrEnum',","    'SemVer',","    'VersionedYamlModel',","    'inject_yaml_hacks',","    'YamlEnum',  # deprecated alias","    'YamlModelMixinConfig',  # alias for YamlModelMixinConfig","]","","from .version import __version__","","from .compat.hacks import inject_all as inject_yaml_hacks","from .compat.types import YamlInt, YamlIntEnum, YamlStr, YamlStrEnum","from .compat.yaml_lib import yaml, yaml_safe_dump, yaml_safe_load","from .mixin import YamlModelMixin, YamlModelMixinConfig","from .model import YamlModel","","try:","    from .ext.semver import SemVer","    from .ext.versioned_model import VersionedYamlModel","","    __all__.extend(['SemVer', 'VersionedYamlModel'])","except ImportError:","    pass","","# Deprecated alias for backward compatibility","from .compat.old_enums import YamlEnum as _Yam